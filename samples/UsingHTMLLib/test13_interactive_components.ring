/*
	HTMLLib Demo 13 - Interactive Components
*/

load "htmllib.ring"

# ------------------------------------------------------------------
# Demo 13: Interactive Components
# ------------------------------------------------------------------
? "Demo 13: Interactive components..."

oHTML = new HTMLWriter
oHTML.setTitle("Interactive Components")
oHTML.setTheme("modern")

oHTML.addRawHTML('<div style="max-width:900px;margin:0 auto;padding:30px">')
oHTML.addHeading(1, "Interactive JavaScript Components")
oHTML.addParagraph("All components work without any external library - pure JavaScript generated by HTMLLib.")
oHTML.addHR()

# Counter
oHTML.addHeading(2, "Counter Component")
oHTML.addJSCounter("counter1", "Quantity:", "1", [])
oHTML.addJSCounter("counter2", "Score:", "0", [:btnStyle = "padding:8px 16px;font-size:1.1rem;cursor:pointer;border:none;border-radius:50%;background:#6c5ce7;color:#fff", :valStyle = "display:inline-block;min-width:60px;text-align:center;font-size:2rem;font-weight:bold;padding:0 15px;color:#6c5ce7"])

oHTML.addSpacer("20px")

# Toggle
oHTML.addHeading(2, "Toggle Visibility")
oHTML.addJSToggle("Show Details", "details-panel", '<div style="padding:20px;background:var(--bg-alt);border-radius:8px;margin-top:10px"><h4>Hidden Content</h4><p>This content was hidden and revealed using addJSToggle(). The button toggles display between none and block.</p></div>', [])

oHTML.addSpacer("10px")
oHTML.addJSToggle("Show Code Example", "code-panel", '<pre style="padding:15px;background:#1e1e1e;color:#dcdcdc;border-radius:8px;margin-top:10px;overflow:auto"><code>oHTML.addJSToggle("Show Details", "details-panel", contentHTML, [])</code></pre>', [])

oHTML.addSpacer("20px")

# JS Tabs
oHTML.addHeading(2, "JavaScript Tabs")
oHTML.addJSTabs("demo-tabs", [
	["Overview", "<h3>Overview</h3><p>HTMLLib provides a rich set of JavaScript-powered components. Each component generates the necessary HTML and JS automatically.</p>"],
	["Features", "<h3>Features</h3><ul><li>Counters with increment/decrement</li><li>Toggle visibility panels</li><li>Tabbed content panels</li><li>Image slideshows</li><li>Countdown timers</li><li>Typing animations</li></ul>"],
	["Usage", '<h3>Usage</h3><pre style="padding:15px;background:#f5f5f5;border-radius:6px;overflow:auto">load "htmllib.ring"\n\ndoc = new HTMLWriter\ndoc.addJSTabs("myTabs", [\n    ["Tab 1", "Content 1"],\n    ["Tab 2", "Content 2"]\n])\ndoc.save("page.html")</pre>']
])

oHTML.addSpacer("20px")

# Collapsible sections
oHTML.addHeading(2, "Collapsible Sections")
oHTML.addJSCollapsible("What is HTMLLib?", "<p>HTMLLib is a pure Ring library for generating HTML5/CSS3 pages programmatically. It supports Bootstrap 5, themes, JavaScript integration, and much more.</p>", [:open = true])
oHTML.addJSCollapsible("How do I install it?", '<p>Install it using <code>ringpm install htmllib from ringpackages</code> then add: <code>load "htmllib.ring"</code></p>', [])
oHTML.addJSCollapsible("Can I use it with Bootstrap?", "<p>Yes! Call <code>oHTML.enableBootstrap()</code> to automatically include Bootstrap 5 CSS and JS from CDN. Then use all the <code>bs*()</code> methods.</p>", [])

oHTML.addRawHTML('</div>')
oHTML.save("js_demo2_interactive.html")
? "  Created: js_demo2_interactive.html"
